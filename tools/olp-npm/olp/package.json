  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@feedpia/olp-darwin-arm64": "=0.1.1",
    "@feedpia/olp-darwin-x64": "=0.1.1",
    "@feedpia/olp-linux-arm64": "=0.1.1",
    "@feedpia/olp-linux-x64": "=0.1.1",
    "@feedpia/olp-win32-x64": "=0.1.1"
  }
