{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [{ "type": "command", "command": "olp-hook", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [{ "type": "command", "command": "olp-hook", "timeout": 10 }]
      }
    ]
  }
}
